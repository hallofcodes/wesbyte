# Supabase (required for auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key (optional). If unset, the Builder page's "Generate" flow
# falls back to a local template chosen from keywords in your prompt instead
# of calling a real model. Set this to enable real AI generation.
# Server-side only — never exposed to the browser.
ANTHROPIC_API_KEY=
